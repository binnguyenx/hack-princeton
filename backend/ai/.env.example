# Copy to .env for local use. Do not commit .env. Leave secrets empty in git.

SKULLFIX_AI_HOST=127.0.0.1
SKULLFIX_AI_PORT=8000

# Chat provider: bedrock (default; AWS Bedrock via langchain-aws) or gemini. No fake-model fallback.
SKULLFIX_CHAT_PROVIDER=bedrock

# AWS Bedrock (ChatBedrockConverse). Credentials use the standard AWS chain:
# prefer AWS_PROFILE (SSO or ~/.aws/credentials); static keys also work. Needs bedrock:InvokeModel(+WithResponseStream).
AWS_REGION=us-east-2
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Model or cross-region inference profile enabled for the account.
SKULLFIX_BEDROCK_MODEL=us.anthropic.claude-3-7-sonnet-20250219-v1:0

# Optional Gemini provider (SKULLFIX_CHAT_PROVIDER=gemini)
GOOGLE_API_KEY=
GEMINI_API_KEY=
# SKULLFIX_GEMINI_MODEL=gemini-3.1-flash-lite

# Optional tracing. Leave false until a local key is set outside git.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=skullfix-ai

# Local files. Checkpoints are not the candidate revision history.
SKULLFIX_AI_DB_PATH=./data/skullfix.sqlite
SKULLFIX_AI_CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
SKULLFIX_AI_ARTIFACT_DIR=./data/artifacts

# Unresolved teammate boundaries. Empty means the integration is not configured.
SKULLFIX_WORKSPACE_BASE_URL=
SKULLFIX_GEOMETRY_BASE_URL=
