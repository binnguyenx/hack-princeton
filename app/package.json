{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run sync:fixtures && vite",
    "build": "npm run sync:fixtures && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "npm run sync:fixtures && vite preview",
    "test": "vitest run",
    "test:integration": "vitest run",
    "test:watch": "vitest",
    "sync:fixtures": "rm -rf public/fixtures/demo-project && mkdir -p public/fixtures && cp -R ../data/fixtures/demo-project public/fixtures/demo-project"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
