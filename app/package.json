{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run sync:fixtures && npm run sync:samples && vite",
    "build": "npm run sync:fixtures && npm run sync:samples && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "npm run sync:fixtures && npm run sync:samples && vite preview",
    "test": "vitest run",
    "test:integration": "vitest run",
    "test:watch": "vitest",
    "sync:fixtures": "rm -rf public/fixtures/demo-project && mkdir -p public/fixtures && cp -R ../data/fixtures/demo-project public/fixtures/demo-project",
    "sync:samples": "node scripts/sync-samples.mjs",
    "test:browser": "playwright test",
    "backend": "../.venv/bin/python -B -m skullfix_ai.api",
    "start": "npm run backend -- --storage-root ../data/storage --frontend-dir dist"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@radix-ui/themes": "^3.2.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
